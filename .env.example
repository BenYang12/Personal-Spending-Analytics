# Copy to .env for local Docker Compose. Never commit the populated .env file.

# Shared secret used only between the Next.js server and Spring backend.
# Replace this with a long random value outside local development.
LEDGERLENS_API_KEY=replace-with-a-long-random-value

# PostgreSQL defaults are convenient locally; override all three when deployed.
POSTGRES_DB=ledgerlens
POSTGRES_USER=ledgerlens
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Plaid developer-dashboard credentials. This project is intentionally pinned
# to Sandbox; users connect simulated institutions through Plaid Link.
PLAID_CLIENT_ID=
PLAID_SECRET=

# Optional. Empty uses deterministic rule-based advice.
ANTHROPIC_API_KEY=

# Applies only when PostgreSQL initializes a brand-new volume.
LEDGERLENS_DEMO_DATA=false
